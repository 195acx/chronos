{"file":"list.cpp","note":"","source":["#include <iostream>\r","\r","struct Node {\r","    int data;\r","    Node* next;\r","};\r","\r","Node* push(Node* head, int value) {\r","    Node* n = new Node{value, head};\r","    return n;\r","}\r","\r","int sum(Node* head) {\r","    int total = 0;\r","    Node* cur = head;\r","    while (cur != nullptr) {\r","        total += cur->data;\r","        cur = cur->next;\r","    }\r","    return total;\r","}\r","\r","int main() {\r","    Node* head = nullptr;\r","    for (int i = 1; i <= 4; i++) {\r","        head = push(head, i * 10);\r","    }\r","    int s = sum(head);\r","    std::cout << s << \"\\n\";\r","    return 0;\r","}"],"steps":[{"stack":[{"func":"main","line":24,"locals":{"head":"0x7fffffffd248 → {data = -10526, next = 0x0} → nullptr","s":"32767"}}]},{"stack":[{"func":"main","line":25,"locals":{"i":"-134534576","head":"nullptr","s":"32767"}}]},{"stack":[{"func":"main","line":26,"locals":{"i":"1","head":"nullptr","s":"32767"}}]},{"stack":[{"func":"main","line":26,"locals":{"i":"1","head":"nullptr","s":"32767"}},{"func":"push","line":9,"locals":{"head":"nullptr","value":"10","n":"0x6c6f6f705f68652e"}}]},{"stack":[{"func":"main","line":26,"locals":{"i":"1","head":"nullptr","s":"32767"}},{"func":"push","line":10,"locals":{"head":"nullptr","value":"10","n":"0x55555556b2b0 → {data = 10, next = 0x0} → nullptr"}}]},{"stack":[{"func":"main","line":26,"locals":{"i":"1","head":"nullptr","s":"32767"}},{"func":"push","line":11,"locals":{"head":"nullptr","value":"10","n":"0x55555556b2b0 → {data = 10, next = 0x0} → nullptr"}}]},{"stack":[{"func":"main","line":25,"locals":{"i":"1","head":"0x55555556b2b0 → {data = 10, next = 0x0} → nullptr","s":"32767"}}]},{"stack":[{"func":"main","line":26,"locals":{"i":"2","head":"0x55555556b2b0 → {data = 10, next = 0x0} → nullptr","s":"32767"}}]},{"stack":[{"func":"main","line":26,"locals":{"i":"2","head":"0x55555556b2b0 → {data = 10, next = 0x0} → nullptr","s":"32767"}},{"func":"push","line":9,"